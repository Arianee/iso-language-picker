{
  "name": "@arianee/iso-language-picker",
  "version": "0.5.0",
  "description": "Pick the best language to display to a user from their preferred languages and the available ones (BCP 47)",
  "main": "lib/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Arianee/iso-language-picker.git"
  },
  "scripts": {
    "test": "vitest run",
    "test:w": "vitest",
    "build": "tsc",
    "prepublishOnly": "npm run test && npm run build",
    "postpublish": "npm version minor && git push"
  },
  "keywords": [
    "i18n",
    "language",
    "locale",
    "bcp47",
    "accept-language",
    "negotiation"
  ],
  "author": "Arianee",
  "license": "ISC",
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "private": false,
  "types": "lib/index.d.ts",
  "files": [
    "lib"
  ],
  "engines": {
    "node": ">=22"
  },
  "homepage": "https://github.com/Arianee/iso-language-picker#readme",
  "bugs": {
    "url": "https://github.com/Arianee/iso-language-picker/issues"
  }
}
